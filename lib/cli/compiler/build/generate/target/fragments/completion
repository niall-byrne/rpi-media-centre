_rpi_bash_completion() {
  local RPI_COMPLETION_COMMAND=""
  local RPI_COMPLETION_COMMAND_LAST=""
  local RPI_COMPLETION_INDEX

  for ((RPI_COMPLETION_INDEX = 0; RPI_COMPLETION_INDEX < "${#COMP_WORDS[@]}"; RPI_COMPLETION_INDEX++)); do
    RPI_COMPLETION_COMMAND+="|${COMP_WORDS[RPI_COMPLETION_INDEX]}"
    if ((RPI_COMPLETION_INDEX + 1 < "${#COMP_WORDS[@]}")); then
      RPI_COMPLETION_COMMAND_LAST+="|${COMP_WORDS[RPI_COMPLETION_INDEX]}"
    fi
  done

  RPI_COMPLETION_COMMAND="${RPI_COMPLETION_COMMAND%?}"

  RPI_AVAILABLE_COMMANDS="$(
    _rpi_bash_completion_lookup "${RPI_COMPLETION_COMMAND}" ||
      _rpi_bash_completion_lookup "${RPI_COMPLETION_COMMAND_LAST}"
  )"

  # shellcheck disable=SC2207
  COMPREPLY=($(compgen -W "${RPI_AVAILABLE_COMMANDS}" -- "${COMP_WORDS[COMP_CWORD]}"))
}
