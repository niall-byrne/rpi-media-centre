[Unit]
Description="The rpi-media-centre backup service."
After=network.target local-fs.target
RequiresMountsFor=${RPI_ROOT}

[Service]
Type=oneshot
Environment="RPI_RUNTIME_ENVIRONMENT=service"
Environment="RPI_SVC_GROUPNAME=${RPI_SVC_GROUPNAME}"
Environment="RPI_SVC_USERNAME=${RPI_SVC_USERNAME}"
ExecStart=/usr/local/sbin/pictl backup service start
Nice=10
User=root
Group=root
UMask=077

[Install]
WantedBy=multi-user.target
