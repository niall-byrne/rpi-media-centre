[Unit]
Description="The rpi-media-centre backup service."
After=network.target local-fs.target
RequiresMountsFor=${RPI_ROOT}

[Service]
Type=oneshot
Environment="RPI_RUNTIME_ENVIRONMENT=service"
ExecStart=/usr/local/bin/pictl backup service start
Nice=10
User=${RPI_CONTAINER_UID}
Group=${RPI_CONTAINER_GID}
UMask=077

[Install]
WantedBy=multi-user.target
